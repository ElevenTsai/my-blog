---
import { sitePath } from '../lib/site';
interface Props {
  href: string;
  title: string;
  excerpt: string;
  tags: { label: string }[];
  date?: string;
  readingTime?: string;
  revealDelay?: 1 | 2 | 3 | 4;
}
const { href, title, excerpt, tags, date, readingTime, revealDelay = 1 } = Astro.props;
---
<a data-astro-prefetch="hover" href={sitePath(href)} class={`post-card reveal d${revealDelay}`}>
  <div class="post-tags">
    {tags.map(tag => <span class="post-tag">{tag.label}</span>)}
  </div>
  <h2 class="post-title">{title}</h2>
  <p class="post-excerpt">{excerpt}</p>
  <div class="post-footer">
    <span class="post-info">
      {date && <time datetime={date}>{date.replaceAll('-', '.')}</time>}
      {readingTime && <span>{readingTime}</span>}
    </span>
    <span class="post-cta" aria-hidden="true">阅读全文 <span>→</span></span>
  </div>
</a>
