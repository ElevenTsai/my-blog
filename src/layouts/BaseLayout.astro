---
// Base HTML shell used by every page.
import '../styles/global.css';
import '../styles/document.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Aurora from '../components/Aurora.astro';
import Starfield from '../components/Starfield.astro';
import { ClientRouter } from 'astro:transitions';
import { sitePath } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  current: 'home' | 'work' | 'posts';
  sourceDocUrl?: string;
  bodyClass?: string;
  showStarfield?: boolean;
  head?: string; // Extra raw HTML for <head> (Prism CDN etc.)
}
const {
  title,
  description = '蔡世逸的个人站 · 工作、工具与思考的一站式记录',
  current,
  sourceDocUrl,
  bodyClass = '',
  showStarfield = true,
  head = '',
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    (() => {
      const root = document.documentElement;
      let choice = 'light';
      try { choice = localStorage.getItem('highlight-info-theme') || choice; } catch {}
      root.dataset.theme = choice === 'auto' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : choice;
      root.dataset.themeChoice = choice;
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.dataset.motionReady = '';
      setTimeout(() => { if (!window.__motionInitialized) root.removeAttribute('data-motion-ready'); }, 1500);
    })();
  </script>
  <ClientRouter fallback="swap" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <title>{title}</title>
  <link rel="icon" href={sitePath("/favicon.ico")} sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href={sitePath("/favicon-32x32.png")} />
  <link rel="icon" type="image/png" sizes="16x16" href={sitePath("/favicon-16x16.png")} />
  <link rel="apple-touch-icon" sizes="180x180" href={sitePath("/apple-touch-icon.png")} />
  <link rel="manifest" href={sitePath("/site.webmanifest")} />
  <meta name="theme-color" content="#4f46e5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#05070d" media="(prefers-color-scheme: dark)" />
  <Fragment set:html={head} />
</head>
<body class={bodyClass} transition:animate="none">
  <div class="site-background" transition:persist="site-background" transition:animate="none" aria-hidden="true">
    <Aurora />
    {showStarfield && <Starfield />}
  </div>
  <Nav current={current} />
  <slot />
  <div class="container">
    <Footer sourceDocUrl={sourceDocUrl} />
  </div>
  <script>
    import '../scripts/theme.js';
    import '../scripts/interactions.js';
  </script>
</body>
</html>
