---
// Base HTML shell used by every page.
import '../styles/global.css';
import '../styles/document.css';
import '../styles/experience.css';
import '../styles/space.css';
import SpaceBackground from '../components/SpaceBackground.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { sitePath } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  current: 'home' | 'work' | 'posts';
  sourceDocUrl?: string;
  bodyClass?: string;
  head?: string; // Extra raw HTML for <head> (Prism CDN etc.)
}
const {
  title,
  description = '蔡世逸的个人站 · 工作、工具与思考的一站式记录',
  current,
  sourceDocUrl,
  bodyClass = '',
  head = '',
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    (() => {
      const root = document.documentElement;
      // Only the initial document may play the home entrance; SPA swaps have their own reveal.
      if (!window.__mySpaceLoaded) {
        window.__mySpaceLoaded = true;
        root.setAttribute('data-initial-page', '');
      }
      let choice = 'auto';
      try { choice = localStorage.getItem('highlight-info-theme') || choice; } catch {}
      if (!['light', 'dark', 'auto'].includes(choice)) choice = 'auto';
      root.dataset.motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'still' : 'full';
      root.dataset.theme = choice === 'auto' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : choice;
      root.dataset.themeChoice = choice;
    })();
  </script>
  <ClientRouter fallback="swap" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <title>{title}</title>
  <link rel="icon" href={sitePath("/favicon.ico")} sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href={sitePath("/favicon-32x32.png")} />
  <link rel="icon" type="image/png" sizes="16x16" href={sitePath("/favicon-16x16.png")} />
  <link rel="apple-touch-icon" sizes="180x180" href={sitePath("/apple-touch-icon.png")} />
  <link rel="manifest" href={sitePath("/site.webmanifest")} />
  <meta name="theme-color" content="#F6F5F2" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
  <Fragment set:html={head} />
</head>
<body class={bodyClass}>
  <SpaceBackground />
  <div class="site-cursor" aria-hidden="true" inert transition:persist="site-cursor" transition:name="site-cursor" transition:animate="none">
    <div class="site-cursor-point"></div>
  </div>
  <Nav current={current} />
  <slot />
  <div class="container">
    <Footer sourceDocUrl={sourceDocUrl} />
  </div>
  <script>
    import '../scripts/theme.js';
    import '../scripts/interactions.js';
    import '../scripts/site-cursor.js';
  </script>
</body>
</html>
