---
// Layout for long-form article pages: adds TOC sidebar and back-to-top.
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BackToTop from '../components/BackToTop.astro';
import TocToggle from '../components/TocToggle.astro';
import DocumentSync from '../components/DocumentSync.astro';
import { highlightDocument } from '../lib/highlight-document';
import { showWork, sitePath, siteHtml } from '../lib/site';
import { estimateReadingMinutes, formatReadingTime, formatArticleDate } from '../lib/article-meta';

interface TocEntry {
  level: number;
  id: string;
  text: string;
  sourceId?: string;
}

interface Props {
  title: string;
  description?: string;
  sourceDocUrl?: string;
  current?: 'work' | 'posts';
  bodyClass?: string;
  highlightCode?: boolean;
  syncedAt?: string;
  sourceRevision?: number;
  readingMinutes?: number;
  publishedAt?: string;
  updatedAt?: string;
  syncDocument?: string;
  breadcrumb: { label: string; href?: string }[];
  toc: TocEntry[];
  contentHtml?: string;
  backLink?: { label: string; href: string };
}
const { title, description, sourceDocUrl, breadcrumb, toc, contentHtml, current = 'posts', bodyClass = '', highlightCode = Boolean(sourceDocUrl), syncedAt, sourceRevision, readingMinutes, publishedAt, updatedAt, syncDocument, backLink } = Astro.props;
const readingLabel = formatReadingTime(readingMinutes ?? estimateReadingMinutes(contentHtml ?? ''));

const renderedHtml = contentHtml ? siteHtml(highlightCode ? await highlightDocument(contentHtml) : contentHtml) : contentHtml;
---
<BaseLayout
  title={title}
  description={description}
  current={current}
  bodyClass={`article-page document-page ${bodyClass}`}
>
  {toc.length > 0 && <TocToggle />}

  <Breadcrumb items={breadcrumb} />

  <div class="document-toolbar">
    <div class="document-meta">
      <span class="document-reading-time">{readingLabel}</span>
      {publishedAt && !updatedAt && <span>发布于 <time datetime={publishedAt}>{formatArticleDate(publishedAt)}</time></span>}
      {updatedAt && <span>最后更新 <time datetime={updatedAt}>{formatArticleDate(updatedAt)}</time></span>}
      {syncedAt && <span title={`网页为同步副本，飞书版本 ${sourceRevision ?? ''}`}>同步于 <time datetime={syncedAt}>{formatArticleDate(syncedAt, true)}</time></span>}
    </div>
    {sourceDocUrl
      ? <a class="document-action" href={sourceDocUrl} target="_blank" rel="noopener">在飞书中打开 ↗</a>
      : <a class="document-action" href={sitePath(backLink?.href ?? (current === 'work' ? '/work/' : '/posts/'))}>{backLink?.label ?? `返回${current === 'work' ? '工作' : '文章'}列表`}</a>}
  </div>

  {showWork && syncDocument && <DocumentSync document={syncDocument} revision={sourceRevision} />}

  <main class="article-layout">
    <article class="article-content">
      {renderedHtml ? <Fragment set:html={renderedHtml} /> : <slot />}
      {sourceDocUrl && <div class="article-footer-note">
        <p>
          内容来自飞书文档
          <a href={sourceDocUrl} target="_blank" rel="noopener">{title} ↗</a>
          。网页为同步副本，最新内容请查看原文。
        </p>
      </div>}
    </article>

    <aside class="article-sidebar" id="article-toc">
      {toc.length > 0 && (
        <nav class="article-toc" aria-label="目录">
          <div class="toc-heading"><div class="toc-title">本文目录</div><button class="toc-close" type="button" aria-label="关闭目录">关闭</button></div>
          {toc.filter((t) => t.level >= 2).map((t) => (
            <div class="toc-entry">
              <a
                class={`toc-link toc-l${t.level}`}
                href={`#${t.id}`}
                data-target={t.id}
                title={t.text}
                style={`--indent: ${t.level - 2}`}
              >{t.text}</a>
              {sourceDocUrl && t.sourceId && <a class="toc-source" href={`${sourceDocUrl}#${t.sourceId}`} target="_blank" rel="noopener" aria-label={`在飞书中打开：${t.text}`} title="在飞书中打开本节">↗</a>}
            </div>
          ))}
        </nav>
      )}
    </aside>
  </main>

  <BackToTop />

  <script>import '../scripts/article.js';</script>
</BaseLayout>
