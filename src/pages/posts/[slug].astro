---
// Dynamic article page: /posts/[slug].html
// Reads content from src/data/notes/{slug}.json (generated by sync/build_notes.py)
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

interface TocEntry {
  level: number;
  id: string;
  text: string;
}
interface Post {
  title: string;
  docUrl: string;
  contentHtml: string;
  toc: TocEntry[];
  description?: string;
  syncedAt?: string;
  sourceRevision?: number;
}

export async function getStaticPaths() {
  const dataDir = path.join(process.cwd(), 'src/data/notes');
  let files: string[] = [];
  try {
    files = (await fs.readdir(dataDir)).filter((f) => f.endsWith('.json'));
  } catch {
    return [];
  }
  return Promise.all(
    files.map(async (file) => {
      const slug = file.replace('.json', '');
      const raw = await fs.readFile(path.join(dataDir, file), 'utf-8');
      return {
        params: { slug },
        props: { post: JSON.parse(raw) as Post },
      };
    })
  );
}

const { post } = Astro.props as { post: Post };
const { slug } = Astro.params;
---
<ArticleLayout
  title={post.title}
  description={post.description}
  sourceDocUrl={post.docUrl}
  syncedAt={post.syncedAt}
  sourceRevision={post.sourceRevision}
  breadcrumb={[
    { label: '首页', href: '/' },
    { label: '文章', href: '/posts/' },
    { label: post.title },
  ]}
  toc={post.toc}
  contentHtml={post.contentHtml}
/>
