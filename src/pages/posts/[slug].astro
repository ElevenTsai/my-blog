---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { loadNotes } from '../../lib/notes';
import { showWork, sitePath } from '../../lib/site';
export async function getStaticPaths() {
  return (await loadNotes()).filter(post => post.section === 'posts' || showWork).map(post => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const moved = post.section === 'work';
const target = sitePath(`/work/${post.slug}.html`);
---
{moved ? (
  <html lang="zh-CN"><head><meta charset="UTF-8"/><meta http-equiv="refresh" content={`0;url=${target}`} /><title>{post.title} · 工作</title><link rel="canonical" href={target}/></head><body><p>文档已移至工作栏目。<a href={target}>前往阅读</a></p><script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script></body></html>
) : (
  <ArticleLayout title={post.title} description={post.description} sourceDocUrl={post.docUrl}
    syncedAt={post.syncedAt} updatedAt={post.updatedAt} syncDocument={post.syncDocument} sourceRevision={post.sourceRevision}
    breadcrumb={[{ label: '首页', href: '/' }, { label: '文章', href: '/posts/' }, { label: post.title }]}
    toc={post.toc} contentHtml={post.contentHtml} />
)}
