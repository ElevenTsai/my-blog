---
// Posts listing page: reads metadata from src/data/notes/*.json
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import CollectionHero from '../../components/CollectionHero.astro';
import CollectionEmpty from '../../components/CollectionEmpty.astro';
import { loadNotes } from '../../lib/notes';
const posts = (await loadNotes()).filter(post => post.section === 'posts');
---
<BaseLayout
  title="文章 · 蔡世逸的个人站"
  description="技术笔记、工作思考、踩坑记录"
  current="posts"
  bodyClass="collection-page"
>
  <main class="page collection-main">
    <CollectionHero title="文章" description="技术笔记、工作思考与踩坑记录，把实践经验写下来。" />

    <section class="collection-content" aria-label="文章列表">
      {posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((post, i) => (
            <PostCard
              href={`/posts/${post.slug}.html`}
              title={post.title}
              excerpt={post.excerpt}
              tags={post.tags}
              readingMinutes={post.readingMinutes}
              revealDelay={((i % 4) + 1) as 1 | 2 | 3 | 4}
            />
          ))}
        </div>
      ) : (
        <CollectionEmpty />
      )}
    </section>
  </main>
</BaseLayout>
