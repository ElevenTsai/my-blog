---
// Posts listing page: reads metadata from src/data/notes/*.json
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import CollectionHero from '../../components/CollectionHero.astro';
import fs from 'node:fs/promises';
import path from 'node:path';
import { showWork, sitePath } from '../../lib/site';
import { estimateReadingMinutes } from '../../lib/article-meta';

interface PostMeta {
  slug: string;
  title: string;
  excerpt: string;
  tags: { label: string; accent?: boolean }[];
  readingMinutes: number;
  order?: number;
}

// Load all note metadata at build time
const dataDir = path.join(process.cwd(), 'src/data/notes');
let posts: PostMeta[] = [];
try {
  const files = await fs.readdir(dataDir);
  const jsonFiles = files.filter((f) => f.endsWith('.json'));
  posts = await Promise.all(
    jsonFiles.map(async (file) => {
      const raw = await fs.readFile(path.join(dataDir, file), 'utf-8');
      const data = JSON.parse(raw);
      return {
        slug: file.replace('.json', ''),
        title: data.title,
        excerpt: data.excerpt || '',
        tags: data.tags || [],
        readingMinutes: estimateReadingMinutes(data.contentHtml || ''),
        order: data.order ?? 999,
      } as PostMeta;
    })
  );
  posts.sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
} catch (e) {
  console.warn('[posts/index] no notes data yet:', (e as Error).message);
}
---
<BaseLayout
  title="文章 · 蔡世逸的个人站"
  description="技术笔记、工作思考、踩坑记录"
  current="posts"
  bodyClass="collection-page"
>
  <main class="page collection-main">
    <CollectionHero title="文章" description="技术笔记、工作思考与踩坑记录，把实践经验写下来。" />

    <section class="collection-content" aria-label="文章列表">
      {posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((post, i) => (
            <PostCard
              href={`/posts/${post.slug}.html`}
              title={post.title}
              excerpt={post.excerpt}
              tags={post.tags}
              readingMinutes={post.readingMinutes}
              revealDelay={((i % 4) + 1) as 1 | 2 | 3 | 4}
            />
          ))}        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
          </div>
          <h3>还没有发布文章</h3>
          <p>
            写作计划正在酝酿中。欢迎先来
            <a href={sitePath(showWork ? "/work/" : "/")} style="color: var(--accent); font-weight: 600;">{showWork ? "工作" : "首页"}</a>
            逛逛。
          </p>
          <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
            <a href={sitePath("/")} class="btn btn-secondary">返回首页</a>
            {showWork && <a href={sitePath("/work/")} class="btn btn-primary">浏览工作</a>}
          </div>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
